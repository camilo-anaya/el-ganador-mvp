}

.liveDemoFooter {
  max-width: 1460px !important;
  color: #8fa696 !important;
}

.liveDemoFooter a {
  color: #8ee3b0 !important;
}

/* ============================================================================
   ESCENARIO PROTAGONISTA EN PANTALLA COMPLETA (BLANCO PURO DE ESTUDIO)
   ============================================================================ */
.liveDemoPage.isCinemaStageLocked {
  height: 100dvh;
  max-height: 100dvh;
  overflow: hidden;
}

.liveDemoMachine.cinemaFullscreenActive {
  position: fixed !important;
  inset: 0 !important;
  z-index: 1100 !important;
  width: 100vw !important;
  height: 100dvh !important;
  min-height: 100dvh !important;
  max-width: none !important;
  margin: 0 !important;
  padding: calc(24px + env(safe-area-inset-top, 0px)) 16px calc(24px + env(safe-area-inset-bottom, 0px)) !important;
  border-radius: 0 !important;
  border: none !important;
  background-color: #0f4627 !important;
  background-image:
    repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.055) 0px, rgba(255, 255, 255, 0.055) 2px, transparent 2px, transparent 16px),
    repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.055) 0px, rgba(255, 255, 255, 0.055) 2px, transparent 2px, transparent 16px),
    radial-gradient(circle at 50% 50%, rgba(245, 215, 120, 0.12) 1.2px, transparent 1.2px),
    radial-gradient(ellipse at 50% 45%, #24884f 0%, #19693b 45%, #104828 78%, #0a351d 100%) !important;
  background-size: 24px 24px, 24px 24px, 18px 18px, 100% 100% !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  overflow: hidden !important;
}

.liveDemoMachine.cinemaFullscreenActive .pneumaticCageWrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 0 !important;
}

.liveDemoMachine.cinemaFullscreenActive .globeChassis {
  width: min(88vw, calc(100dvh - 256px), 680px) !important;
  aspect-ratio: 1 / 1 !important;
  margin: 0 auto !important;
}

.liveDemoMachine.cinemaFullscreenActive .heroExtractedBall {
  width: min(68%, 460px) !important;
  height: min(68%, 460px) !important;
  z-index: 100 !important;
}

.liveDemoMachine.cinemaFullscreenActive .machineHalo {
  width: min(98vw, 80dvh, 820px) !important;
  height: min(98vw, 80dvh, 820px) !important;
  top: 50% !important;
  left: 50% !important;
  transform: translate(-50%, -50%) !important;
  background: radial-gradient(ellipse at 50% 50%, rgba(74, 222, 128, 0.32) 0%, rgba(245, 215, 120, 0.18) 38%, rgba(16, 185, 129, 0.08) 60%, transparent 74%) !important;
  filter: blur(32px) !important;
  transition: background 0.6s ease, filter 0.6s ease !important;
}

/* ILUMINACIÓN Y BRILLO ACTIVO CUANDO SE JUEGA LA BALOTA (AGITACIÓN Y SUCCIÓN) */
.liveDemoMachine.stage_mixing.cinemaFullscreenActive .machineHalo,
.liveDemoMachine.stage_suction.cinemaFullscreenActive .machineHalo,
.liveDemoMachine.isSpinning.cinemaFullscreenActive .machineHalo {
  background: radial-gradient(ellipse at 50% 50%, rgba(94, 234, 160, 0.42) 0%, rgba(245, 215, 120, 0.24) 36%, rgba(16, 185, 129, 0.12) 62%, transparent 76%) !important;
  filter: blur(34px) !important;
}

.liveDemoMachine.stage_reveal.cinemaFullscreenActive .machineHalo,
.liveDemoMachine.hasWinner.cinemaFullscreenActive .machineHalo {
  background: radial-gradient(ellipse at 50% 50%, rgba(251, 191, 36, 0.42) 0%, rgba(52, 211, 153, 0.26) 42%, transparent 76%) !important;
  filter: blur(36px) !important;
}

.liveDemoMachine.cinemaFullscreenActive .suctionTube {
  width: 78px !important;
  height: auto !important;
  margin-bottom: -2.5px !important;
  z-index: 45 !important;
  display: flex !important;
}

.liveDemoMachine.cinemaFullscreenActive .ballChute {
  display: flex !important;
  justify-content: center !important;
  min-height: 46px !important;
  padding: 8px 22px !important;
  margin-top: 4px !important;
  margin-bottom: 0 !important;
}

.liveDemoMachine.cinemaFullscreenActive .cinemaWinnerSpotlightBar {
  display: flex !important;
  position: absolute !important;
  bottom: calc(14px + env(safe-area-inset-bottom, 0px)) !important;
  left: 50% !important;
  transform: translateX(-50%) !important;
  z-index: 60 !important;
  width: auto !important;
  max-width: 90vw !important;
}

.liveDemoMachine.cinemaFullscreenActive:has(.cinemaWinnerSpotlightBar) .ballChute {
  display: none !important;
}

.liveDemoMachine.cinemaFullscreenActive .wheelCasinoWrapper {
  --wheel-size: clamp(260px, min(84vw, calc(100dvh - 215px)), 600px) !important;
  max-width: 100% !important;
  margin-top: clamp(28px, 5vh, 52px) !important; /* Desplaza la ruleta hacia abajo, alejándola del borde superior y reflectores */
  margin-bottom: 20px !important;
  padding: var(--wrapper-pad-top) var(--wrapper-pad-x) 0 !important;
}

.liveDemoMachine.cinemaFullscreenActive .wheelFacetedHub {
  width: calc(var(--wheel-size) * 0.22) !important;
  height: calc(var(--wheel-size) * 0.22) !important;
}

.liveDemoMachine.cinemaFullscreenActive .wheelPedestalStand {
  width: min(88%, calc(var(--wheel-size) * 0.96)) !important;
  height: clamp(42px, calc(var(--wheel-size) * 0.135), 68px) !important;
  margin-top: calc(var(--bulb-d) * 2.8) !important;
}

.liveDemoMachine.cinemaFullscreenActive .machineStandWrapper {
  display: flex !important;
  width: min(88%, 460px) !important;
  margin: -12px auto 6px !important;
}

.liveDemoMachine.cinemaFullscreenActive .machineStand {
  display: flex !important;
  width: 100% !important;
  padding: 0 !important;
}

/* HUD SUPERIOR: EN DIRECTO + CONTROL DE AUDIO (REPOSO Y PANTALLA COMPLETA 8 AM) */
.cinemaStageTopHud {
  position: absolute;
  top: calc(14px + env(safe-area-inset-top, 0px));
  left: 18px;
  right: 18px;
  z-index: 25;
  display: flex !important;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
}

.liveDemoMachine.cinemaFullscreenActive .cinemaStageTopHud {
  position: absolute;
  top: calc(16px + env(safe-area-inset-top, 0px));
  left: 20px;
  right: 20px;
  z-index: 50;
  display: flex !important;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
}

.cinemaHudRight {
  display: flex;
  align-items: center;
  gap: 10px;
}

.cinemaLiveBadge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 6px 14px;
  border-radius: 999px;
  background: #082816;
  border: 1.5px solid #dab960;
  color: #ffe599;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.6px;
  white-space: nowrap;
}

.cinemaLiveBadge i {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #18b85a;
  box-shadow: 0 0 10px rgba(24, 184, 90, 0.7);
  animation: demoPulse 1.1s infinite;
}

.cinemaAudioBtn {
  background: #f0f4f1;
  border: 1.5px solid #b6ccbc;
  color: #0d3820;
  font-weight: 800;
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 11.5px;
  cursor: pointer;
  transition: background 0.2s;
}
.cinemaAudioBtn:hover {
  background: #e1ede4;
}

.cinemaExitBtn {
  background: #082816;
  border: 1.5px solid #d4a838;
  color: #fce38a;
  font-weight: 900;
  padding: 6px 16px;
  border-radius: 999px;
  font-size: 11.5px;
  cursor: pointer;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
  transition: all 0.2s;
}
.cinemaExitBtn:hover {
  background: #0d3d22;
  color: #ffffff;
}

/* BALOTA INCÓGNITA EN LA TORRETA DE SUCCIÓN */
.suctionTubeBall.suctionBallMystery {
  animation: mysteryBallShine 1.1s infinite alternate ease-in-out;
}
.suctionBallMystery .suctionBallNumber {
  font-size: 24px !important;
  font-weight: 950 !important;
  color: #4a3104 !important;
  text-shadow: 0 1px 2px rgba(255, 240, 180, 0.95) !important;
}
@keyframes mysteryBallShine {
  0% { transform: scale(0.96); filter: drop-shadow(0 0 6px rgba(255, 215, 0, 0.5)); }
  100% { transform: scale(1.08); filter: drop-shadow(0 0 16px rgba(255, 235, 120, 0.95)); }
}



.cinemaWinnerSpotlightBar {
  margin-top: 14px;
  padding: 10px 20px;
  border-radius: 16px;
  background: linear-gradient(105deg, #103d25, #082315);
  border: 2px solid #e5bd54;
  box-shadow: 0 14px 34px rgba(10, 42, 26, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
  z-index: 25;
  max-width: 92vw;
}

.cinemaWinnerSpotlightBar strong {
  color: #ffe891;
  font-size: clamp(13px, 2.4vmin, 18px);
  font-weight: 950;
  letter-spacing: 0.5px;
  text-align: center;
}

.cinemaFinishNowBtn {
  padding: 8px 15px;
  border-radius: 999px;
  border: 1px solid #fff5cb;
  background: linear-gradient(105deg, #ffe482, #d99f22);
  color: #081f12;
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
}

/* ============================================================================
   WEB RESPONSIVE PC / ESCRITORIO: MOTOR Y BALOTA DE LUJO EN GRAN FORMATO
   (El diseño móvil <= 820px conserva intactas sus medidas ideales para celular)
   ============================================================================ */
@media (min-width: 821px) {
  .liveDemoStage {
    max-width: 1460px;
  }

  .liveDemoStageGrid {
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(20px, 2.8vw, 44px);
    padding: 24px clamp(18px, 3vw, 44px) 34px;
  }

  .liveDemoMachine {
    min-height: 660px;
    padding: 28px 20px;
    border-radius: 26px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 24px 64px rgba(0, 0, 0, 0.6);
  }

  .wheelCasinoWrapper {
    --wheel-size: clamp(300px, 54vw, 440px);
  }

  .liveDemoDetails {
    max-width: 100%;
  }

  .globeChassis {
    width: min(94%, 620px);
    max-width: 100%;
  }

  .machineHalo {
    width: 820px;
    height: 780px;
  }

  .stage_reveal .machineHalo {
    width: 900px;
    height: 840px;
  }

  .suctionTube {
    width: 78px !important;
    height: auto !important;
    margin-bottom: -2.5px !important;
    z-index: 12 !important;
  }

  .suctionDomeCap {
    width: 56px !important;
    height: 25px !important;
    border-radius: 28px 28px 3px 3px !important;
  }

  .suctionGlass {
    width: 46px !important;
    height: 36px !important;
    margin-top: -1px !important;
    border-radius: 0 !important;
  }

  .suctionBaseCollar {
    width: 72px !important;
    height: 11px !important;
    margin-top: 0 !important;
    border-radius: 3.5px 3.5px 2px 2px !important;
  }

  .suctionTubeBall {
    width: 34px !important;
    height: 34px !important;
    bottom: -56px !important;
  }

  .suctionActive .suctionTubeBall,
  .stage_slowdown .suctionTubeBall,
  .stage_reveal .suctionTubeBall,
  .hasWinner .suctionTubeBall {
    bottom: 2px !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .suctionBallNumber {
    font-size: 13.5px !important;
  }

  .machineStandWrapper {
    width: min(88%, 420px) !important;
    margin: -12px auto 12px !important;
  }

  .machineTwinPillars {
    width: 210px !important;
    height: 24px !important;
  }

  .machinePillar {
    width: 26px !important;
  }

  .machineStand {
    width: 100% !important;
    height: auto !important;
  }

  .heroExtractedBall {
    width: min(56%, 350px);
    height: min(56%, 350px);
  }

  .heroBallNumber {
    font-size: clamp(62px, 6vw, 96px);
  }

  .ballWatermark {
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 4px;
  }

  .ballUnderlineBar {
    width: 52px;
    height: 5px;
  }

  .ballChute {
    width: min(92%, 640px);
    min-height: 58px;
    font-size: 14px;
    margin-top: 18px;
  }

  .wheelDrumCasing {
    width: var(--wheel-size);
    height: var(--wheel-size);
  }
  .wheelBoard {
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 1 / 1 !important;
  }

  /* En Pantalla Completa en PC: Balotera y Balota Ganadora Monumental Protagonista con margen superior e inferior libre */
  .liveDemoMachine.cinemaFullscreenActive .globeChassis {
    width: min(88vw, calc(100dvh - 256px), 680px) !important;
  }

  .liveDemoMachine.cinemaFullscreenActive .heroExtractedBall {
    width: min(68%, 480px) !important;
    height: min(68%, 480px) !important;
  }

  .liveDemoMachine.cinemaFullscreenActive .heroBallNumber {
    font-size: clamp(84px, 10vmin, 136px) !important;
  }
}

@media (max-width: 768px) {
  .liveDemoMachine.cinemaFullscreenActive {
    padding: calc(56px + env(safe-area-inset-top, 0px)) 12px calc(24px + env(safe-area-inset-bottom, 0px)) !important;
  }
  .cinemaStageTopHud {
    left: 10px;
    right: 10px;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cinemaLiveBadge {
    padding: 5px 10px;
    font-size: 9px;
  }
  .cinemaAudioBtn,
  .cinemaExitBtn {
    padding: 5px 10px;
    font-size: 10px;
  }
  .winnerSocialShareButton {
    grid-column: 1 / -1;
  }
  .socialFormatTabs {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .socialFormatBtn {
    font-size: 10.5px;
    padding: 7px 6px;
  }
  .socialPreviewViewport {
    min-height: 210px;
    padding: 8px;
  }
  .socialPreviewImage {
    max-height: 34dvh;
  }
  .socialNetCard {
    padding: 10px 4px;
  }
  .socialNetCard strong {
    font-size: 11.5px;
  }
  .socialNetCard small {
    font-size: 9px;
  }
  .btnSocialUtility {
    font-size: 10px;
    padding: 8px 4px;
  }
}

/* ============================================================================
   SEPARACIÓN DE ROLES: MODO EMPRESARIO VS MODO CLIENTE (CELULAR / ESPECTADOR)
   ============================================================================ */

/* 1. BARRA DE CONTROL DEL EMPRESARIO (Solo visible para el administrador) */
.entrepreneurControlBar {
  max-width: 1460px;
  margin: 10px auto 14px;
  padding: 10px 18px;
  background: linear-gradient(135deg, rgba(16, 68, 40, 0.95), rgba(8, 38, 22, 0.98));
  border: 1px solid rgba(220, 185, 80, 0.45);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  z-index: 20;
  box-sizing: border-box;
}

.entrepreneurTitleGroup {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.entrepreneurBadge {
  background: linear-gradient(105deg, #d4a737, #f7d879);
  color: #092415;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.5px;
  padding: 4px 10px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.entrepreneurSub {
  color: #cde2d3;
  font-size: 11.5px;
  font-weight: 600;
}

.entrepreneurActions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.btnCopyClientLink,
.btnCopyReminderLink,
.btnToggleClientPreview {
  padding: 7px 14px;
  border-radius: 8px;
  font-size: 11.5px;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.btnCopyClientLink {
  background: #0d3820;
  border: 1px solid #38ef7d;
  color: #aff5ca;
}

.btnCopyClientLink:hover {
  background: #155531;
  color: #ffffff;
}

.btnCopyReminderLink {
  background: rgba(14, 165, 233, 0.15);
  border: 1px solid #38bdf8;
  color: #bae6fd;
}

.btnCopyReminderLink:hover {
  background: rgba(14, 165, 233, 0.3);
  color: #ffffff;
  border-color: #7dd3fc;
}

.btnToggleClientPreview {
  background: linear-gradient(105deg, #ffe482, #d99f22);
  border: 1px solid #fff5cb;
  color: #081f12;
}

.btnToggleClientPreview:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(217, 159, 34, 0.4);
}

/* 2. TARJETAS DEL CLIENTE EN MODO ESPECTADOR (CELULAR) */
.clientViewerWaitingCard,
.clientViewerWinnerCard {
  position: absolute;
  bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  left: 50%;
  transform: translateX(-50%);
  width: min(92vw, 480px);
  background: linear-gradient(165deg, rgba(14, 56, 33, 0.96) 0%, rgba(7, 30, 18, 0.98) 100%);
  border: 1.5px solid rgba(220, 185, 80, 0.6);
  border-radius: 18px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  padding: 14px 18px;
  z-index: 60;
  box-sizing: border-box;
  text-align: center;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  animation: clientCardFadeUp 0.4s ease-out forwards;
}

@keyframes clientCardFadeUp {
  from { opacity: 0; transform: translate(-50%, 15px); }
  to { opacity: 1; transform: translate(-50%, 0); }
}

.clientViewerHeader {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  color: #9fe2be;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 4px;
}

.clientStatusDot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 8px #34d399;
  animation: demoPulse 1.5s infinite;
}

.clientWaitingTitle {
  color: #ffffff;
  font-size: 15px;
  font-weight: 900;
  margin: 0 0 4px;
}

.clientWaitingSub {
  color: #bad3c3;
  font-size: 11px;
  line-height: 1.35;
  margin: 0 0 10px;
}

.clientTicketInputBox {
  background: rgba(4, 18, 11, 0.75);
  border: 1px solid rgba(220, 185, 80, 0.35);
  border-radius: 12px;
  padding: 10px 12px;
  margin-bottom: 10px;
}

.clientTicketLabel {
  display: block;
  color: #f3df9f;
  font-size: 11px;
  font-weight: 800;
  margin-bottom: 6px;
  text-align: left;
}

.clientTicketRow {
  display: flex;
  gap: 8px;
  align-items: center;
}

.clientTicketField {
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(220, 185, 80, 0.4);
  border-radius: 8px;
  padding: 8px 12px;
  color: #ffffff;
  font-size: 14px;
  font-weight: 800;
  outline: none;
  box-sizing: border-box;
}

.clientTicketField:focus {
  border-color: #38ef7d;
  background: rgba(255, 255, 255, 0.12);
}

.clientTicketSaveBtn {
  background: linear-gradient(105deg, #d4a737, #f7d879);
  color: #092415;
  border: none;
  border-radius: 8px;
  padding: 8px 16px;
  font-size: 12px;
  font-weight: 900;
  cursor: pointer;
  white-space: nowrap;
}

.clientTicketSaveBtn:hover {
  filter: brightness(1.1);
}

.clientTicketSavedNotice {
  margin: 6px 0 0;
  color: #5eead4;
  font-size: 10.5px;
  font-weight: 700;
  text-align: left;
}

/* ============================================================================
   INTEGRACIÓN OFICIAL: PERFIL CLIENTE Y BOLETAS COMPRADAS VERIFICADAS
   ============================================================================ */
.clientOfficialTicketsBox {
  background: rgba(4, 24, 15, 0.88);
  border: 1.5px solid rgba(220, 185, 80, 0.5);
  border-radius: 12px;
  padding: 11px 13px;
  margin-bottom: 10px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
}

.clientProfileBadgeRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 6px;
}

.clientVerifiedBadge {
  color: #f7da7c;
  font-size: 11.5px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 4px;
}

.clientTicketsCountTag {
  background: rgba(56, 239, 125, 0.15);
  border: 1px solid #38ef7d;
  color: #86efac;
  font-size: 9.5px;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 999px;
}

.clientTicketsInstructions {
  color: #bad3c3;
  font-size: 10.5px;
  margin: 0 0 8px;
  text-align: left;
}

.clientTicketsBadgesList {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;
  justify-content: flex-start;
}

.clientTicketGoldPill {
  background: linear-gradient(135deg, #2a1f0a, #141006);
  border: 1.5px solid #f5cf6d;
  color: #ffe69c;
  font-size: 13px;
  font-weight: 900;
  padding: 4px 10px;
  border-radius: 6px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5), inset 0 0 8px rgba(245, 207, 109, 0.15);
  display: inline-flex;
  align-items: center;
  gap: 2px;
}

.clientTicketsAutoNotice {
  color: #93c5fd;
  font-size: 9.5px;
  line-height: 1.35;
  margin: 0;
  text-align: left;
}

.clientAccountGateBox {
  background: rgba(4, 20, 13, 0.85);
  border: 1px solid rgba(220, 185, 80, 0.35);
  border-radius: 12px;
  padding: 10px 12px;
  margin-bottom: 10px;
}

.clientLoginPrompt {
  text-align: center;
  margin-bottom: 8px;
}

.clientPromptTitle {
  color: #f7da7c;
  font-size: 11.5px;
  font-weight: 800;
  margin: 0 0 2px;
}

.clientPromptSub {
  color: #bad3c3;
  font-size: 10px;
  margin: 0 0 8px;
}

.btnClientGoLogin {
  display: block;
  background: linear-gradient(105deg, #d4a737, #f7d879);
  color: #092415;
  font-size: 11px;
  font-weight: 900;
  padding: 7px 14px;
  border-radius: 8px;
  text-decoration: none;
  transition: all 0.2s ease;
}

.btnClientGoLogin:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}

.clientSearchByEmailRow {
  margin-top: 8px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 8px;
}

.clientOrDivider {
  display: block;
  color: #6ee7b7;
  font-size: 9px;
  margin-bottom: 6px;
  text-align: center;
}

.clientEmailSearchForm {
  display: flex;
  gap: 6px;
}

.clientNoTicketsNotice {
  background: rgba(4, 20, 13, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 12px;
  padding: 10px 12px;
  margin-bottom: 10px;
  text-align: left;
  font-size: 10.5px;
  color: #e2f1e6;
}

.clientNoTicketsSub {
  color: #bad3c3;
  font-size: 9.5px;
  margin: 4px 0 8px;
}

.btnClientViewAccount,
.clientBtnProfileLink {
  display: inline-block;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid #38ef7d;
  color: #86efac;
  font-size: 10.5px;
  font-weight: 800;
  padding: 5px 12px;
  border-radius: 6px;
  text-decoration: none;
  transition: all 0.2s ease;
}

.winnerAccountSavedTag {
  color: #ffd700;
  font-size: 10px;
  font-weight: 700;
  margin-top: 4px;
}

.clientTestDemoWrap {
  margin-top: 6px;
}

.btnClientSimulation {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #9fe2be;
  border-radius: 8px;
  padding: 6px 14px;
  font-size: 10.5px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btnClientSimulation:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  border-color: #38ef7d;
}

/* 3. RESULTADO DE COMPROBACIÓN DE BOLETO */
.clientWinnerBadgeRow {
  margin-bottom: 8px;
}

.winnerTrophyBadge {
  background: linear-gradient(105deg, #d4a737, #f7d879);
  color: #081f12;
  font-size: clamp(13px, 2.8vmin, 16px);
  font-weight: 950;
  letter-spacing: 0.5px;
  padding: 6px 16px;
  border-radius: 999px;
  display: inline-block;
}

.clientWinnerResultBanner {
  border-radius: 12px;
  padding: 10px 14px;
  margin-bottom: 10px;
}

.clientWinnerResultBanner.matchedWinner {
  background: linear-gradient(135deg, rgba(22, 101, 52, 0.95), rgba(16, 185, 129, 0.3));
  border: 1.5px solid #4ade80;
}

.clientWinnerResultBanner.notMatched {
  background: rgba(4, 18, 11, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.winnerCongratsTitle {
  color: #fef08a;
  font-size: 13.5px;
  font-weight: 900;
  margin: 0 0 4px;
}

.winnerCongratsSub {
  color: #ecfdf5;
  font-size: 11px;
  margin: 0;
}

.winnerNormalTitle {
  color: #ffffff;
  font-size: 12px;
  font-weight: 800;
  margin: 0 0 2px;
}

.winnerNormalSub {
  color: #a7f3d0;
  font-size: 10.5px;
  margin: 0;
}

.clientWinnerActions {
  display: flex;
  gap: 8px;
  justify-content: center;
}

.clientBtnCertificate {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(220, 185, 80, 0.5);
  color: #ffe69c;
  padding: 8px 16px;
  border-radius: 8px;
  font-size: 11.5px;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.2s ease;
}

.clientBtnCertificate:hover {
  background: rgba(220, 185, 80, 0.2);
  border-color: #ffd700;
  color: #ffffff;
}

/* 4. BOTÓN DE SALIDA DISCRETO PARA EL EMPRESARIO */
.clientExitBar {
  position: absolute;
  top: calc(14px + env(safe-area-inset-top, 0px));
  left: 50%;
  transform: translateX(-50%);
  z-index: 70;
}

.btnExitViewerMode {
  background: rgba(0, 0, 0, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #d1fae5;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 9.5px;
  font-weight: 700;
  cursor: pointer;
  backdrop-filter: blur(8px);
}

.btnExitViewerMode:hover {
  background: rgba(220, 38, 38, 0.85);
  border-color: #fca5a5;
  color: #ffffff;
}

/* 5. HERRAMIENTAS DE RECORDATORIO: GOOGLE CALENDAR, GMAIL Y WHATSAPP */
.clientReminderBlock {
  margin-top: 10px;
  padding: 10px 12px;
  background: rgba(3, 20, 12, 0.75);
  border: 1px solid rgba(220, 185, 80, 0.35);
  border-radius: 12px;
  text-align: left;
}

.reminderHeader {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.reminderBellIcon {
  font-size: 16px;
  animation: bellRing 2s infinite ease-in-out;
}

@keyframes bellRing {
  0%, 100% { transform: rotate(0); }
  10%, 30% { transform: rotate(14deg); }
  20%, 40% { transform: rotate(-14deg); }
  50% { transform: rotate(0); }
}

.reminderTitle {
  display: block;
  color: #f7da7c;
  font-size: 11px;
  font-weight: 800;
  line-height: 1.25;
}

.reminderSubtitle {
  display: block;
  color: #9fe2be;
  font-size: 9.5px;
  margin-top: 1px;
}

.reminderButtonsGrid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 6px;
}

.btnReminderGoogle {
  background: linear-gradient(135deg, #1a4f32, #103822);
  border: 1px solid #4ade80;
  color: #ffffff;
  padding: 7px 10px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  text-decoration: none;
  transition: all 0.2s ease;
  cursor: pointer;
}

.btnReminderGoogle:hover {
  background: #1b633d;
  border-color: #86efac;
  transform: translateY(-1px);
}

.btnReminderIcs,
.btnReminderWhatsApp {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(220, 185, 80, 0.3);
  color: #e2f1e6;
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 10px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btnReminderIcs:hover,
.btnReminderWhatsApp:hover {
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
}

.btnReminderWhatsApp {
  border-color: #25d366;
  color: #86efac;
}

/* Ocultar cápsula redundante en modo espectador para evitar colisiones visuales en celulares */
.liveDemoMachine.cinemaFullscreenActive.clientViewerActive .ballChute {
  display: none !important;
}

/* ============================================================================
   ILUMINACIÓN DE ESTUDIO TV EN "X" + DESTELLOS ALEATORIOS EXTERIORES (CRISTAL 100% INTACTO)
   ============================================================================ */
.stageBroadcastLighting {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  overflow: hidden;
}

.stageSpotUnit {
  position: absolute;
  width: 84px;
  height: 72px;
  pointer-events: none;
}

.spotHousingWrap {
  position: relative;
  z-index: 4;
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.72));
}

.spotHousingSvg {
  width: 100%;
  height: 100%;
  display: block;
}

/* Haces volumétricos suaves con caída óptica gradual (Cero bordes rígidos) */
.spotBeamCone {
  position: absolute;
  left: 50%;
  pointer-events: none;
  will-change: opacity;
  animation: studioBeamBreathe 6.5s ease-in-out infinite alternate;
}

.spotBeamCone.coneFromTop {
  top: 44px;
  width: 560px;
  height: 760px;
  transform: translateX(-50%);
  background: conic-gradient(
    from 158deg at 50% 0%,
    transparent 0deg,
    rgba(246, 212, 110, 0.14) 10deg,
    rgba(255, 244, 186, 0.36) 17deg,
    rgba(255, 253, 236, 0.56) 22deg,
    rgba(255, 244, 186, 0.36) 27deg,
    rgba(246, 212, 110, 0.14) 34deg,
    transparent 44deg
  );
  -webkit-mask-image: radial-gradient(ellipse 68% 96% at 50% 0%, #000 0%, rgba(0, 0, 0, 0.78) 26%, rgba(0, 0, 0, 0.28) 62%, transparent 94%);
  mask-image: radial-gradient(ellipse 68% 96% at 50% 0%, #000 0%, rgba(0, 0, 0, 0.78) 26%, rgba(0, 0, 0, 0.28) 62%, transparent 94%);
  filter: blur(10px);
}

.spotBeamCone.coneFromBottom {
  bottom: 0;
  width: 520px;
  height: 680px;
  transform: translateX(-50%);
  background: conic-gradient(
    from 338deg at 50% 100%,
    transparent 0deg,
    rgba(246, 212, 110, 0.10) 10deg,
    rgba(255, 240, 175, 0.24) 17deg,
    rgba(255, 251, 225, 0.40) 22deg,
    rgba(255, 240, 175, 0.24) 27deg,
    rgba(246, 212, 110, 0.10) 34deg,
    transparent 44deg
  );
  -webkit-mask-image: radial-gradient(ellipse 68% 96% at 50% 100%, #000 0%, rgba(0, 0, 0, 0.68) 24%, rgba(0, 0, 0, 0.22) 60%, transparent 92%);
  mask-image: radial-gradient(ellipse 68% 96% at 50% 100%, #000 0%, rgba(0, 0, 0, 0.68) 24%, rgba(0, 0, 0, 0.22) 60%, transparent 92%);
  filter: blur(12px);
}

@keyframes studioBeamBreathe {
  0% { opacity: 0.84; }
  100% { opacity: 1; }
}

/* Posicionamiento en Tarjeta Normal de Escritorio (Debajo de EN DIRECTO y Sonido, cero colisión) */
.spotTopLeft {
  top: 52px;
  left: -14px;
  transform-origin: 50% 6px;
  transform: rotate(-42deg);
}

.spotTopRight {
  top: 52px;
  right: -14px;
  transform-origin: 50% 6px;
  transform: rotate(42deg);
}

.spotTopRight .spotBeamCone {
  animation-delay: -3.1s;
}

.spotBottomLeft {
  bottom: -16px;
  left: -18px;
  transform-origin: 50% 100%;
  transform: rotate(40deg);
}

.spotBottomLeft .spotBeamCone {
  animation-delay: -1.7s;
}

.spotBottomRight {
  bottom: -16px;
  right: -18px;
  transform-origin: 50% 100%;
  transform: rotate(-40deg);
}

.spotBottomRight .spotBeamCone {
  animation-delay: -4.4s;
}

/* Posicionamiento en Pantalla Completa PC (Reflectores en el techo del escenario enmarcando en "X", separados de EN DIRECTO y Sonido) */
@media (min-width: 900px) {
  .liveDemoMachine.cinemaFullscreenActive .spotTopLeft {
    top: -10px;
    left: clamp(305px, 20vw, 390px);
    transform: rotate(-47deg);
  }

  .liveDemoMachine.cinemaFullscreenActive .spotTopRight {
    top: -10px;
    right: clamp(305px, 20vw, 390px);
    transform: rotate(47deg);
  }

  /* En Modo Ruleta la etiqueta EN DIRECTO · RULETA XX PARTICIPANTES es más ancha: separamos simétricamente */
  .liveDemoMachine.cinemaFullscreenActive.modeWheel .spotTopLeft {
    left: clamp(368px, 24.5vw, 440px);
    transform: rotate(-43deg);
  }

  .liveDemoMachine.cinemaFullscreenActive.modeWheel .spotTopRight {
    right: clamp(368px, 24.5vw, 440px);
    transform: rotate(43deg);
  }

  .liveDemoMachine.cinemaFullscreenActive .spotBottomLeft {
    bottom: -18px;
    left: clamp(32px, 6.5vw, 150px);
    transform: rotate(52deg);
  }

  .liveDemoMachine.cinemaFullscreenActive .spotBottomRight {
    bottom: -18px;
    right: clamp(32px, 6.5vw, 150px);
    transform: rotate(-52deg);
  }

  .liveDemoMachine.cinemaFullscreenActive .spotBeamCone.coneFromTop {
    width: 640px;
    height: 920px;
  }

  .liveDemoMachine.cinemaFullscreenActive .spotBeamCone.coneFromBottom {
    width: 600px;
    height: 820px;
  }
}

/* Versión Teléfonos (Vertical): Se ocultan las carcasas negras para no tocar EN DIRECTO ni Sonido; quedan haces limpios */
@media (max-width: 899px) {
  .spotHousingWrap {
    display: none !important;
  }

  .spotTopLeft {
    top: -16px;
    left: -28px;
    transform-origin: 50% 0%;
    transform: rotate(-32deg);
  }

  .spotTopRight {
    top: -16px;
    right: -28px;
    transform-origin: 50% 0%;
    transform: rotate(32deg);
  }

  .spotBottomLeft {
    bottom: -16px;
    left: -28px;
    transform-origin: 50% 100%;
    transform: rotate(32deg);
  }

  .spotBottomRight {
    bottom: -16px;
    right: -28px;
    transform-origin: 50% 100%;
    transform: rotate(-32deg);
  }

  .spotBeamCone.coneFromTop {
    top: 0;
    width: 360px;
    height: 520px;
    opacity: 0.76;
  }

  .spotBeamCone.coneFromBottom {
    width: 320px;
    height: 440px;
    opacity: 0.46;
  }
}

/* DESTELLOS ESTRELLA DE 4 PUNTAS SOBRE EL ARO DORADO EXTERIOR + MICROPARTÍCULAS EXTERIORES */
.baloteraSparkleHalo {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  overflow: visible;
}

.baloteraExteriorSpark {
  position: absolute;
  width: var(--spark-size, 4px);
  height: var(--spark-size, 4px);
  border-radius: 50%;
  background: radial-gradient(circle, #ffffff 0%, #fff2b2 45%, #f0c24b 100%);
  box-shadow: 0 0 8px 2px rgba(255, 224, 112, 0.85), 0 0 16px rgba(245, 194, 66, 0.45);
  transform: translate(-50%, -50%) scale(0);
  opacity: 0;
  pointer-events: none;
  will-change: transform, opacity;
  animation: exteriorGoldSparkTwinkle 4.2s ease-in-out infinite;
}

@keyframes exteriorGoldSparkTwinkle {
  0%, 20%, 100% {
    opacity: 0;
    transform: translate(-50%, -50%) translateY(4px) scale(0.2);
  }
  46% {
    opacity: 1;
    transform: translate(-50%, -50%) translateY(-2px) scale(1.18);
  }
  68% {
    opacity: 0.58;
    transform: translate(-50%, -50%) translateY(-6px) scale(0.82);
  }
  85% {
    opacity: 0;
    transform: translate(-50%, -50%) translateY(-9px) scale(0.15);
  }
}

.baloteraBezelGlints {
  position: absolute;
  inset: 0;
  z-index: 8;
  pointer-events: none;
  overflow: visible;
}

.wheelBezelGlints {
  z-index: 32;
}

.wheelSparkleHalo {
  z-index: 1;
}

.bezelStarGlintItem {
  position: absolute;
  width: var(--glint-size, 24px);
  height: var(--glint-size, 24px);
  transform: translate(-50%, -50%) scale(0) rotate(0deg);
  opacity: 0;
  filter: drop-shadow(0 0 6px rgba(255, 236, 145, 0.96)) drop-shadow(0 0 13px rgba(245, 194, 66, 0.7));
  pointer-events: none;
  will-change: transform, opacity;
  animation: bezelStarFlash 4.5s ease-in-out infinite;
}

.bezelStarSvg {
  width: 100%;
  height: 100%;
  display: block;
}

@keyframes bezelStarFlash {
  0%, 30%, 100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.14) rotate(-10deg);
  }
  52% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.06) rotate(12deg);
  }
  72% {
    opacity: 0.46;
    transform: translate(-50%, -50%) scale(0.64) rotate(24deg);
  }
  86% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.12) rotate(32deg);
  }
}

@media (min-width: 980px) {
  .liveDemoStageGrid {
    grid-template-columns: minmax(0, 1.54fr) minmax(320px, 0.94fr);
    gap: clamp(24px, 3vw, 48px);
    padding: 28px clamp(20px, 3.2vw, 46px) 36px;
  }
  .liveDemoMachine {
    min-height: 800px;
  }
  .wheelCasinoWrapper {
    --wheel-size: clamp(340px, 38vw, 560px);
  }
  .liveDemoDetails {
    max-width: 440px;
  }
}

@media (max-width: 760px) {
  .liveDemoMachine.cinemaFullscreenActive .wheelCasinoWrapper {
    --wheel-size: clamp(190px, min(80vw, calc(100dvh - 235px)), 350px) !important;
    margin-top: 18px !important;
    margin-bottom: 26px !important;
    padding: var(--wrapper-pad-top) var(--wrapper-pad-x) 0 !important;
  }
  .liveDemoMachine.cinemaFullscreenActive .cinemaWinnerSpotlightBar {
    width: calc(100vw - 24px) !important;
    max-width: 380px !important;
    padding: 8px 14px !important;
    gap: 6px !important;
    border-radius: 14px !important;
    bottom: calc(10px + env(safe-area-inset-bottom, 0px)) !important;
    box-sizing: border-box !important;
  }
  .liveDemoMachine.cinemaFullscreenActive .cinemaWinnerSpotlightBar strong {
    font-size: 12.5px !important;
    line-height: 1.2 !important;
  }
  .liveDemoMachine.cinemaFullscreenActive .cinemaFinishNowBtn {
    padding: 6px 14px !important;
    font-size: 11px !important;
    white-space: nowrap !important;
  }
  .bezelStarGlintItem {
    width: calc(var(--glint-size, 24px) * 0.64);
    height: calc(var(--glint-size, 24px) * 0.64);
  }
  .baloteraExteriorSpark {
    width: calc(var(--spark-size, 4px) * 0.8);
    height: calc(var(--spark-size, 4px) * 0.8);
  }
}

@media (max-height: 540px) {
  .liveDemoMachine.cinemaFullscreenActive {
    padding: calc(10px + env(safe-area-inset-top, 0px)) 12px calc(12px + env(safe-area-inset-bottom, 0px)) !important;
  }
  .liveDemoMachine.cinemaFullscreenActive .wheelCasinoWrapper {
    --wheel-size: clamp(140px, min(44vw, calc(100dvh - 165px)), 245px) !important;
    margin-bottom: 24px !important;
    padding: var(--wrapper-pad-top) var(--wrapper-pad-x) 0 !important;
  }
  .liveDemoMachine.cinemaFullscreenActive .ballChute {
    min-height: 32px !important;
    padding: 4px 12px !important;
    font-size: 9.5px !important;
    margin-top: 4px !important;
  }
}

/* ============================================================================
   REVELACIÓN MONUMENTAL 3D DEL NÚMERO GANADOR EN LA RULETA (AL DETENERSE)
   ============================================================================ */
.liveDemoMachine .wheelDrumCasing .wheelHeroWinnerBall,
.liveDemoMachine.cinemaFullscreenActive .wheelDrumCasing .wheelHeroWinnerBall {
  width: 46% !important;
  height: auto !important;
  aspect-ratio: 1 / 1 !important;
  z-index: 36 !important;
}

.liveDemoMachine .wheelDrumCasing .wheelHeroWinnerBall .heroBallCenterDisc {
  width: 68% !important;
  height: 68% !important;
  padding: 4px;
  box-sizing: border-box;
}

.liveDemoMachine .wheelDrumCasing .wheelHeroWinnerBall .heroBallNumber,
.liveDemoMachine.cinemaFullscreenActive .wheelDrumCasing .wheelHeroWinnerBall .heroBallNumber {
  font-size: calc(var(--wheel-size) * 0.135) !important;
  letter-spacing: -1.5px;
  line-height: 0.95;
}

.liveDemoMachine .wheelDrumCasing .wheelHeroWinnerBall .ballUnderlineBar {
  width: calc(var(--wheel-size) * 0.085);
  height: clamp(2px, calc(var(--wheel-size) * 0.008), 4px);
  margin-top: 2px;
}

.wheelWinnerCustomName {
  max-width: 92%;
  margin-top: 2px;
  font-size: clamp(7px, calc(var(--wheel-size) * 0.024), 11.5px);
  font-weight: 900;
  color: #7c5610;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.liveDemoMachine .wheelDrumCasing .wheelHeroWinnerBall .ballWatermark {
  font-size: clamp(6.5px, calc(var(--wheel-size) * 0.02), 10px) !important;
  letter-spacing: 1.2px !important;
  margin-top: 2px !important;
}

.wheelDrumCasing .wheelGanasteCrown {
  top: auto !important;
  bottom: 6.5% !important;
  z-index: 38 !important;
  font-size: clamp(9px, calc(var(--wheel-size) * 0.03), 14.5px) !important;
  padding: clamp(3px, calc(var(--wheel-size) * 0.01), 6px) clamp(10px, calc(var(--wheel-size) * 0.034), 18px) !important;
  letter-spacing: 1.2px !important;
  white-space: nowrap !important;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.88), 0 0 22px rgba(245, 198, 68, 0.85) !important;
}

.wheelDrumCasing.drumWinner {
  box-shadow:
    inset 0 2px 3px rgba(255, 255, 255, 0.95),
    inset 0 -8px 18px rgba(46, 28, 4, 0.92),
    0 0 0 3px #f5ce66,
    0 0 42px rgba(245, 200, 76, 0.65),
    0 32px 64px rgba(0, 0, 0, 0.95);
}

/* Intensificación elegante cuando se revela el ganador */
.liveDemoMachine.stage_reveal .spotBeamCone,
.liveDemoMachine.hasWinner .spotBeamCone {
  filter: blur(9px) brightness(1.18);
}
