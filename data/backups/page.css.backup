}

/* ============================================================================
   SECCIÓN DE TRANSPARENCIA Y AUDITORÍA: VERDE ROLEX ESMERALDA CON MÁXIMO CONTRASTE
   ============================================================================ */
.liveDemoAudit {
  max-width: 1460px !important;
  margin: 32px auto 0 !important;
  padding: 32px 34px !important;
  border-radius: 24px !important;
  background: radial-gradient(ellipse at 50% 12%, #144e30 0%, #0b3621 45%, #051d12 100%) !important;
  border: 1.5px solid rgba(229, 196, 104, 0.45) !important;
  box-shadow:
    0 24px 60px rgba(0, 0, 0, 0.75),
    inset 0 1px 0 rgba(255, 255, 255, 0.2),
    0 0 44px rgba(16, 72, 44, 0.35) !important;
  position: relative !important;
  overflow: hidden !important;
}

.liveDemoAuditIntro {
  display: flex !important;
  align-items: center !important;
  gap: 18px !important;
}

.auditShield {
  width: 52px !important;
  height: 52px !important;
  flex: 0 0 52px !important;
  display: grid !important;
  place-items: center !important;
  border: 2px solid #ecd07a !important;
  border-radius: 16px !important;
  color: #ffd778 !important;
  background: rgba(229, 196, 104, 0.16) !important;
  font-size: 24px !important;
  font-weight: 900 !important;
  box-shadow: 0 0 20px rgba(236, 208, 122, 0.3) !important;
}

.liveDemoEyebrow {
  color: #f0ce71 !important;
  font-size: 12px !important;
  font-weight: 900 !important;
  letter-spacing: 2px !important;
  text-transform: uppercase !important;
  margin-bottom: 4px !important;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8) !important;
}

.liveDemoAuditIntro h2 {
  margin: 0 !important;
  color: #ffffff !important;
  font-size: clamp(20px, 2.5vw, 27px) !important;
  font-weight: 900 !important;
  letter-spacing: -0.3px !important;
  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8) !important;
  line-height: 1.25 !important;
}

.liveDemoAuditIntro p:last-child {
  margin: 8px 0 0 !important;
  color: #e5f2eb !important;
  font-size: 14.5px !important;
  font-weight: 500 !important;
  line-height: 1.6 !important;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7) !important;
}

.liveDemoAuditItems {
  display: grid !important;
  grid-template-columns: repeat(3, 1fr) !important;
  gap: 16px !important;
  margin-top: 24px !important;
}

.liveDemoAuditItems > div {
  display: grid !important;
  grid-template-columns: 32px 1fr !important;
  gap: 6px 12px !important;
  padding: 18px 20px !important;
  border: 1.2px solid rgba(229, 196, 104, 0.32) !important;
  border-radius: 16px !important;
  background: rgba(4, 24, 15, 0.85) !important;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.4) !important;
}

.liveDemoAuditItems > div > span {
  grid-row: span 2 !important;
  color: #ffd778 !important;
  font-size: 16px !important;
  font-weight: 900 !important;
  font-family: 'JetBrains Mono', monospace !important;
  text-shadow: 0 0 10px rgba(255, 215, 120, 0.4) !important;
}

.liveDemoAuditItems b {
  color: #ffffff !important;
  font-size: 14px !important;
  font-weight: 800 !important;
  letter-spacing: 0.2px !important;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6) !important;
}

.liveDemoAuditItems small {
  color: #d1e8dc !important;
  font-size: 12.5px !important;
